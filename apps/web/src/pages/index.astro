---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { brandedItems } from "../app_data/branded_items";
import { coreStack } from "../app_data/core_stack";
import { educations } from "../app_data/education";
import { experiences } from "../app_data/experience";
import { projects } from "../app_data/projects";
import { profile } from "../app_data/profile";
---

<Layout>
  <div class="portfolio-page" data-portfolio-tabs>
    <!-- Hero -->
    <main>
      <section
        class="hero section flex flex-col-reverse sm:flex-row items-center sm:items-start justify-between"
      >
        <div>
          <h1
            class="mt-4 mb-3 max-w-4xl text-5xl leading-[1.05] tracking-[-0.08em] text-balance uppercase sm:text-7xl md:text-8xl lg:text-8xl"
          >
            {profile.name}
          </h1>
          <p class="intro">{profile.location}</p>
          <p class="role">{profile.role}</p>
          <p class="intro">{profile.line}</p>
          <div class="hero-actions">
            <a
              class="button primary transition-transform duration-150 hover:scale-105"
              href="#contact">Start a conversation</a
            >
            <a
              class="button secondary transition-transform duration-150 hover:scale-105"
              href={profile.cv}>View CV</a
            >
          </div>
        </div>

        <figure
          class="hero-photo max-w-36 shrink-0 rotate-0 justify-start sm:max-w-56"
        >
          <div class="overflow-hidden rounded-full border border-gray-200 bg-white shadow-[var(--shadow)] ring-4 ring-[var(--surface)]">
            <Image
              src="/jan-1-8.webp"
              alt={profile.name}
              width="224"
              height="224"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block aspect-square w-full scale-[1.22] object-cover object-[center_28%]"
            />
          </div>
          <figcaption
            class="text-muted grid gap-1.5 px-1 pt-3.5 pb-0.5 text-sm sm:text-base"
          >
          </figcaption>
        </figure>
      </section>

      <section
        class="section stack-section"
        aria-labelledby="core-stack-heading"
      >
        <div>
          <h2
            id="core-stack-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            I'm most comfortable with
          </h2>
        </div>
        <div class="flex flex-wrap gap-x-12 pt-4 justify-center">
          {
            coreStack.map((skill) => {
              const item = brandedItems[skill];

              return (
                <div class="grid min-h-36 content-center justify-items-center gap-3.5  text-[var(--muted)] text-md font-extrabold text-center">
                  <Image
                    src={item.logoUrl}
                    alt={item.displayName}
                    width={52}
                    height={52}
                    class="stack-logo"
                  />
                  <span>{item.displayName}</span>
                </div>
              );
            })
          }
        </div>
      </section>

      <section
        class="section timeline-section"
        aria-labelledby="timeline-heading"
      >
        <div>
          <h2
            id="timeline-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            Work and education
          </h2>
        </div>

        <div class="tabs pt-4">
          <div role="tablist" aria-label="Work history" class="tab-list">
            <button
              type="button"
              role="tab"
              id="tab-experience"
              aria-selected="true"
              aria-controls="panel-experience"
              data-tab="experience"
            >
              Work Experience
            </button>
            <button
              type="button"
              role="tab"
              id="tab-education"
              aria-selected="false"
              aria-controls="panel-education"
              data-tab="education"
              tabindex="-1"
            >
              Education
            </button>
          </div>

          <!-- Experience -->
          <div
            role="tabpanel"
            id="panel-experience"
            aria-labelledby="tab-experience"
            class="timeline-list"
          >
            {
              experiences.map((job) => (
                <article class="timeline-card">
                  <div class="card-heading">
                    <h3>{job.role}</h3>
                    <span>{job.period}</span>
                  </div>
                  <p class="organization">{job.company}</p>
                  <p>{job.description}</p>
                  <div class="tech-row">
                    {job.tech.map((tech) => {
                      const item = brandedItems[tech];

                      return (
                        <Image
                          src={item.logoUrl}
                          alt={item.displayName}
                          title={item.displayName}
                          width={24}
                          height={24}
                          class="tech-logo"
                        />
                      );
                    })}
                  </div>
                </article>
              ))
            }
          </div>

          <div
            role="tabpanel"
            id="panel-education"
            aria-labelledby="tab-education"
            class="timeline-list"
            hidden
          >
            {
              educations.map((education) => (
                <article class="timeline-card">
                  <div class="card-heading">
                    <h3>{education.degree}</h3>
                    <span>{education.period}</span>
                  </div>
                  <p class="organization">{education.school}</p>
                  <p>{education.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section
        class="section projects-section"
        aria-labelledby="projects-heading"
      >
        <div>
          <h2
            id="projects-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            Personal projects
          </h2>
        </div>

        <div class="project-grid pt-4">
          {
            projects.map((project) => (
              <article class="project-card">
                <div class="card-heading">
                  <h3>{project.name}</h3>
                  <span>{project.year}</span>
                </div>
                <p>{project.description}</p>
                <div class="tech-row">
                  {project.tech.map((tech) => {
                    const item = brandedItems[tech];

                    return (
                      <Image
                        src={item.logoUrl}
                        alt={item.displayName}
                        title={item.displayName}
                        width={24}
                        height={24}
                        class="tech-logo"
                      />
                    );
                  })}
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer id="contact" class="contact-footer">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Jan Härkönen</h2>
      </div>
      <div class="contact-links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span>{profile.phone}</span>
        <a href={profile.github} target="_blank" rel="noopener noreferrer"
          >Github</a
        >
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
      </div>
    </footer>
  </div>

  <script>
    function initPortfolioTabs(root: HTMLElement) {
      const tabs = [
        ...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const panels = [
        ...root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
      ];

      function selectTab(tab: HTMLButtonElement) {
        const name = tab.dataset.tab;
        if (!name) return;

        tabs.forEach((item) => {
          const isSelected = item === tab;
          item.setAttribute("aria-selected", String(isSelected));
          item.tabIndex = isSelected ? 0 : -1;
        });

        panels.forEach((panel) => {
          panel.hidden = panel.id !== `panel-${name}`;
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => selectTab(tab));

        tab.addEventListener("keydown", (event) => {
          const index = tabs.indexOf(tab);
          let nextIndex: number | null = null;

          if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
          if (event.key === "ArrowLeft")
            nextIndex = (index - 1 + tabs.length) % tabs.length;

          if (nextIndex !== null) {
            event.preventDefault();
            selectTab(tabs[nextIndex]);
            tabs[nextIndex].focus();
          }
        });
      });
    }

    document
      .querySelectorAll<HTMLElement>("[data-portfolio-tabs]")
      .forEach(initPortfolioTabs);
  </script>
</Layout>
