---
import Layout from "../layouts/Layout.astro";
import ExperienceEducationTabs from "../components/ExperienceEducationTabs.astro";
import { getDB } from "../lib/mongo";
import { z } from "zod";

const db = await getDB();

// Core stack
const coreStackSchema = z.array(z.string());
const coreStackNotValidated = await db.collection("core_stack").findOne();
const coreStack = coreStackSchema.parse(coreStackNotValidated?.content ?? []);

// Experience
const experienceSchema = z.object({
  role: z.string(),
  company: z.string(),
  period: z.string(),
  description: z.string(),
  tech: z.array(z.string()),
});
const experienceNotValidatedCursor = await db.collection("experience").find();
const experiences: z.infer<typeof experienceSchema>[] = [];
for await (const experienceNotValidated of experienceNotValidatedCursor) {
  experiences.push(experienceSchema.parse(experienceNotValidated));
}
experiences.reverse();

// Education
const educationSchema = z.object({
  degree: z.string(),
  school: z.string(),
  period: z.string(),
  description: z.string(),
  documents: z.array(z.string()),
});
const educationNotValidatedCursor = await db.collection("education").find();
const educations: z.infer<typeof educationSchema>[] = [];
for await (const educationNotValidated of educationNotValidatedCursor) {
  educations.push(educationSchema.parse(educationNotValidated));
}
educations.reverse();

// Projects
const projectSchema = z.object({
  name: z.string(),
  year: z.string(),
  description: z.string(),
  tech: z.array(z.string()),
  initiallyHidden: z.boolean(),
});
const projectNotValidatedCursor = await db.collection("projects").find();
const projects: z.infer<typeof projectSchema>[] = [];
for await (const projectNotValidated of projectNotValidatedCursor) {
  projects.push(projectSchema.parse(projectNotValidated));
}
projects.reverse()
---

<Layout title="Jan Härkönen — Senior Full Stack Developer">
  <main class="container mx-auto max-w-5xl px-4 py-16 md:px-6">
    <!-- Hero -->
    <section class="mb-20">
      <p class="text-sm text-neutral-500 mb-2">Helsinki, Finland 🇫🇮</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-3">Jan Härkönen</h1>
      <h2 class="text-xl md:text-2xl text-neutral-400 mb-4">Senior Full Stack Developer</h2>
      <p class="text-neutral-400 text-lg italic">"Writing software that's pleasant to look at"</p>
    </section>

    <!-- Skills -->
    <section class="mb-20">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-500 mb-6">Core Stack</h3>
      <div class="flex flex-wrap gap-3">
        {coreStack.map((skill) => (
          <span class="px-4 py-2 rounded-full bg-neutral-900 border border-neutral-800 text-sm text-neutral-300">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <ExperienceEducationTabs experiences={experiences} educations={educations} />

    <!-- Projects -->
    <section class="mb-20">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-500 mb-8">Projects</h3>
      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => (
          <div class="rounded-lg border border-neutral-800 bg-neutral-900/50 p-5 hover:border-neutral-700 transition-colors">
            <div class="flex items-baseline justify-between mb-2">
              <h4 class="text-base font-medium text-white">{project.name}</h4>
              <span class="text-xs text-neutral-600">{project.year}</span>
            </div>
            <p class="text-sm text-neutral-400 mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.tech.map((t) => (
                <span class="text-xs px-2 py-0.5 rounded bg-neutral-800 text-neutral-500">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <footer class="border-t border-neutral-800 pt-12 pb-8">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-500 mb-6">Contact</h3>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 text-sm text-neutral-400">
        <a href="mailto:jan.harkonen@taitounited.fi" class="hover:text-white transition-colors">jan.harkonen@taitounited.fi</a>
        <span class="hidden sm:inline text-neutral-700">·</span>
        <span>+358 50 4646 745</span>
        <span class="hidden sm:inline text-neutral-700">·</span>
        <a href="https://github.com/janharkonen" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Github</a>
        <span class="hidden sm:inline text-neutral-700">·</span>
        <a href="https://www.linkedin.com/in/janharkonen" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
      </div>
      <p class="text-xs text-neutral-700 mt-8">&copy; 2026 Jan Härkönen</p>
    </footer>
  </main>
</Layout>
