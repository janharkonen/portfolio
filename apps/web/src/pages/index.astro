---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import {
  ArrowRight,
  BookOpenText,
  ExternalLink,
  Mail,
  Phone,
  User,
} from "@lucide/astro";
import { Image } from "astro:assets";
import { brandedItems } from "../../../../packages/app_data/branded_items";
import { coreStack } from "../../../../packages/app_data/core_stack";
import { educations } from "../../../../packages/app_data/education";
import { experiences } from "../../../../packages/app_data/experience";
import { projects } from "../../../../packages/app_data/projects";
import { profile } from "../../../../packages/app_data/profile";

const featuredProjects = projects.filter((project) => project.featured);
const moreProjects = projects.filter((project) => !project.featured);
---

<Layout>
  <div class="portfolio-page">
    <!-- Hero -->
    <main>
      <section
        class="hero section flex flex-col-reverse sm:flex-row items-center sm:items-start justify-between"
      >
        <div>
          <h1
            class="mt-4 mb-3 max-w-4xl text-5xl leading-[1.05] tracking-[-0.08em] text-balance uppercase sm:text-7xl md:text-8xl lg:text-8xl"
          >
            {profile.name}
          </h1>
          <p class="intro">{profile.location}</p>
          <p class="role">{profile.role}</p>
          <p class="intro">{profile.line}</p>
          <div class="hero-actions">
            <a
              class="button primary transition-transform duration-150 hover:scale-105"
              href="#contact">Start a conversation</a
            >
            <a
              class="button secondary transition-transform duration-150 hover:scale-105"
              href={profile.cv}>View CV</a
            >
          </div>
        </div>

        <figure
          class="hero-photo max-w-36 shrink-0 rotate-0 justify-start sm:max-w-56"
        >
          <div
            class="overflow-hidden rounded-full border border-gray-200 bg-white shadow-[var(--shadow)] ring-4 ring-[var(--surface)]"
          >
            <Image
              src="/jan-1-8.webp"
              alt={profile.name}
              width="224"
              height="224"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block aspect-square w-full scale-[1.22] object-cover object-[center_28%]"
            />
          </div>
          <figcaption
            class="text-muted grid gap-1.5 px-1 pt-3.5 pb-0.5 text-sm sm:text-base"
          >
          </figcaption>
        </figure>
      </section>

      <!-- Core stack -->
      <section
        class="section stack-section"
        aria-labelledby="core-stack-heading"
      >
        <div>
          <h2
            id="core-stack-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            I'm most comfortable with
          </h2>
        </div>
        <div class="flex flex-wrap gap-x-12 pt-4 justify-center">
          {
            coreStack.map((skill) => {
              const item = brandedItems[skill];

              return (
                <div class="grid min-h-36 content-center justify-items-center gap-3.5  text-[var(--muted)] text-md font-extrabold text-center">
                  <Image
                    src={item.logoUrl}
                    alt={item.displayName}
                    width={52}
                    height={52}
                    class="stack-logo"
                  />
                  <span>{item.displayName}</span>
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Work and education -->
      <section
        class="section timeline-section"
        aria-labelledby="timeline-heading"
      >
        <div>
          <h2
            id="timeline-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            Work and education
          </h2>
        </div>

        <div
          class="group/timeline grid gap-[18px] pt-4"
          role="radiogroup"
          aria-label="Work history"
        >
          <input
            class="sr-only"
            type="radio"
            name="timeline-section"
            id="tab-experience"
            aria-controls="panel-experience"
            checked
          />
          <input
            class="sr-only"
            type="radio"
            name="timeline-section"
            id="tab-education"
            aria-controls="panel-education"
          />
          <div
            class="grid grid-cols-2 gap-2 border border-[var(--line)] bg-[var(--surface)] p-1.5"
          >
            <label
              for="tab-experience"
              class="cursor-pointer px-[18px] py-[13px] text-center text-[0.92rem] font-black text-[var(--muted)] group-has-[#tab-experience:checked]/timeline:bg-[var(--ink)] group-has-[#tab-experience:checked]/timeline:text-[var(--page)] group-has-[#tab-experience:checked]/timeline:shadow-[0_10px_24px_rgba(24,33,45,0.14)] group-has-[#tab-experience:focus-visible]/timeline:ring-2 group-has-[#tab-experience:focus-visible]/timeline:ring-[var(--ink)] group-has-[#tab-experience:focus-visible]/timeline:ring-offset-2"
            >
              Work Experience
            </label>
            <label
              for="tab-education"
              class="cursor-pointer px-[18px] py-[13px] text-center text-[0.92rem] font-black text-[var(--muted)] group-has-[#tab-education:checked]/timeline:bg-[var(--ink)] group-has-[#tab-education:checked]/timeline:text-[var(--page)] group-has-[#tab-education:checked]/timeline:shadow-[0_10px_24px_rgba(24,33,45,0.14)] group-has-[#tab-education:focus-visible]/timeline:ring-2 group-has-[#tab-education:focus-visible]/timeline:ring-[var(--ink)] group-has-[#tab-education:focus-visible]/timeline:ring-offset-2"
            >
              Education
            </label>
          </div>

          <!-- Experience -->
          <div
            id="panel-experience"
            aria-labelledby="tab-experience"
            class="hidden gap-[14px] group-has-[#tab-experience:checked]/timeline:grid"
          >
            {
              experiences.map((job) => (
                <article class="timeline-card">
                  <div class="flex items-start justify-between">
                    <Image
                      src={brandedItems[job.logo.key].logoUrl}
                      alt={job.company}
                      width={job.logo.width}
                      height={job.logo.height}
                    />
                    {job.documents && (
                      <div class="doc-links">
                        {job.documents.map((doc) => (
                          <a
                            href={doc.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-tooltip={doc.description}
                            aria-label={`Open document: ${doc.description}`}
                          >
                            <BookOpenText size={22} aria-hidden="true" />
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="card-heading pt-4">
                    <h3>{job.role}</h3>
                    <span>{job.period}</span>
                  </div>
                  <p class="organization">{job.company}</p>
                  <p>{job.description}</p>
                  <div class="tech-row">
                    {job.tech.map((tech) => (
                      <Logo skill={tech} />
                    ))}
                  </div>
                </article>
              ))
            }
          </div>

          <!-- Education -->
          <div
            id="panel-education"
            aria-labelledby="tab-education"
            class="hidden gap-[14px] group-has-[#tab-education:checked]/timeline:grid"
          >
            {
              educations.map((education) => (
                <article class="timeline-card">
                  <div class="flex items-start justify-between">
                    <Image
                      src={brandedItems[education.logo.key].logoUrl}
                      alt={education.school}
                      width={education.logo.width}
                      height={education.logo.height}
                    />
                    {education.documents && (
                      <div class="doc-links">
                        {education.documents.map((doc) => (
                          <a
                            href={doc.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-tooltip={doc.description}
                            aria-label={`Open document: ${doc.description}`}
                          >
                            <BookOpenText size={22} aria-hidden="true" />
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="card-heading pt-4">
                    <h3>{education.degree}</h3>
                    <span>{education.period}</span>
                  </div>
                  <p class="organization">{education.school}</p>
                  <p>{education.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section
        class="section projects-section"
        aria-labelledby="projects-heading"
      >
        <div>
          <h2
            id="projects-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            Featured projects
          </h2>
        </div>

        <div class="project-grid project-grid--featured pt-4">
          {
            featuredProjects.map((project) => (
              <article class="project-card">
                <Image
                  src={project.imageUrl}
                  alt={`${project.name} preview`}
                  width={640}
                  height={360}
                  class="mb-[18px] block aspect-video w-full max-w-md mx-auto object-cover"
                />
                <div class="card-heading">
                  <h3>{project.name}</h3>
                  <span>{project.year}</span>
                </div>
                <p>{project.description}</p>
                <div class="tech-row">
                  {project.tech.map((tech) => (
                    <Logo skill={tech} />
                  ))}
                </div>
                {(project.projectUrl ||
                  project.githubUrl ||
                  project.readMore) && (
                  <div class="project-links">
                    {project.projectUrl && (
                      <a
                        href={project.projectUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <ExternalLink size={16} aria-hidden="true" />
                        View project
                      </a>
                    )}
                    {project.githubUrl && (
                      <a
                        href={project.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <img
                          class="project-link-icon"
                          src="/logos/github.svg"
                          alt=""
                          aria-hidden="true"
                        />
                        GitHub
                      </a>
                    )}
                    {project.readMore && (
                      <a class="project-read-more" href={project.readMore}>
                        More
                        <ArrowRight size={16} aria-hidden="true" />
                      </a>
                    )}
                  </div>
                )}
              </article>
            ))
          }
        </div>

        {
          moreProjects.length > 0 && (
            <details class="projects-more">
              <summary class="projects-show-all">Show all</summary>
              <div class="project-grid project-grid--more pt-4">
                {moreProjects.map((project) => (
                  <article class="project-card project-card--compact">
                    <Image
                      src={project.imageUrl}
                      alt={`${project.name} preview`}
                      width={640}
                      height={360}
                      class="mb-[18px] block aspect-video w-full max-w-md mx-auto object-cover"
                    />
                    <div class="card-heading">
                      <h3>{project.name}</h3>
                      <span>{project.year}</span>
                    </div>
                    <p>{project.description}</p>
                    <div class="tech-row">
                      {project.tech.map((tech) => (
                        <Logo skill={tech} />
                      ))}
                    </div>
                    {(project.projectUrl ||
                      project.githubUrl ||
                      project.readMore) && (
                      <div class="project-links">
                        {project.projectUrl && (
                          <a
                            href={project.projectUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <ExternalLink size={16} aria-hidden="true" />
                            View project
                          </a>
                        )}
                        {project.githubUrl && (
                          <a
                            href={project.githubUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <img
                              class="project-link-icon"
                              src="/logos/github.svg"
                              alt=""
                              aria-hidden="true"
                            />
                            GitHub
                          </a>
                        )}
                        {project.readMore && (
                          <a class="project-read-more" href={project.readMore}>
                            More
                            <ArrowRight size={16} aria-hidden="true" />
                          </a>
                        )}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </details>
          )
        }
      </section>
    </main>

    <footer
      id="contact"
      class="contact-footer"
      aria-labelledby="contact-heading"
    >
      <div class="contact-intro">
        <div>
          <h2
            id="contact-heading"
            class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]"
          >
            Contact
          </h2>
        </div>
        <div class="contact-links">
          <span> Jan Härkönen </span>
          <a href={`mailto:${profile.email}`}>
            <Mail size={16} aria-hidden="true" />
            {profile.email}
          </a>
          <a href={`tel:${profile.phone.replace(/\s+/g, "")}`}>
            <Phone size={16} aria-hidden="true" />
            {profile.phone}
          </a>
        </div>
      </div>

      <form
        id="contact-form"
        class="contact-form"
        method="POST"
        action="/api/contact_web"
      >
        <label class="contact-field">
          <span>Name</span>
          <input
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Your name"
            required
          />
        </label>
        <label class="contact-field">
          <span>Email</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </label>
        <label class="contact-field">
          <span>Message</span>
          <textarea
            name="message"
            rows="6"
            placeholder="Hey Jan,

I'd like to chat about..."
            required></textarea>
        </label>
        <button
          class="button primary transition-transform duration-150 hover:scale-105"
          type="submit"
        >
          Send message
        </button>
        <p
          id="contact-form-status"
          class="contact-form-status"
          aria-live="polite"
        >
        </p>
      </form>
    </footer>

    <aside class="terminal-invite" aria-label="SSH terminal">
      <div class="terminal-invite__prompt" aria-hidden="true">
        <span>Try it!</span>
        <svg viewBox="0 0 92 58" role="presentation">
          <path d="M4 7c20 1 8 21 28 18s31-9 38 23"></path>
          <path d="m61 40 9 9 8-10"></path>
        </svg>
      </div>
      <button
        type="button"
        class="terminal-invite__command"
        aria-label="Copy ssh terminal.janharkonen.fi"
        data-command="ssh terminal.janharkonen.fi"
      >
        ssh terminal.janharkonen.fi
      </button>
      <span class="sr-only" aria-live="polite" data-terminal-invite-status
      ></span>
    </aside>
  </div>
</Layout>

<script>
  // On touch devices there is no hover: first tap shows the tooltip,
  // second tap follows the link.
  const hoverless = window.matchMedia("(hover: none)");
  const docLinks = document.querySelectorAll<HTMLAnchorElement>(".doc-links a");

  const closeTooltips = (except?: HTMLAnchorElement) => {
    docLinks.forEach((link) => {
      if (link !== except) link.classList.remove("tooltip-open");
    });
  };

  docLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!hoverless.matches) return;
      if (!link.classList.contains("tooltip-open")) {
        event.preventDefault();
        closeTooltips(link);
        link.classList.add("tooltip-open");
      }
    });
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest(".doc-links a")) {
      closeTooltips();
    }
  });

  const copyCommand = async (text: string) => {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
    } catch {
      // Fall through to execCommand fallback.
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.left = "-9999px";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    document.body.removeChild(textarea);
  };

  const inviteButton = document.querySelector<HTMLButtonElement>(
    ".terminal-invite__command",
  );
  const inviteStatus = document.querySelector<HTMLElement>(
    "[data-terminal-invite-status]",
  );

  if (inviteButton) {
    const command =
      inviteButton.dataset.command ?? "ssh terminal.janharkonen.fi";
    const label = inviteButton.textContent?.trim() || command;
    let restoreTimer = 0;

    inviteButton.addEventListener("click", async () => {
      await copyCommand(command);
      inviteButton.textContent = "Copied!";
      if (inviteStatus) inviteStatus.textContent = "Copied to clipboard";
      window.clearTimeout(restoreTimer);
      restoreTimer = window.setTimeout(() => {
        inviteButton.textContent = label;
        if (inviteStatus) inviteStatus.textContent = "";
      }, 1500);
    });
  }
</script>
