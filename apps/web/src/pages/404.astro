---
import Layout from "../layouts/Layout.astro";
import { ArrowLeft } from "@lucide/astro";
---

<Layout
  title="Page not found — Jan Härkönen"
  description="This page does not exist. Return to Jan Härkönen's portfolio home."
  noindex
>
  <div class="portfolio-page">
    <main id="main-content" class="not-found-shell" tabindex="-1">
      <section class="not-found-card" aria-labelledby="not-found-heading">
        <p class="eyebrow">404</p>

        <h1 id="not-found-heading">Page not found.</h1>
        <p class="not-found-copy">
          The page you're looking for doesn't exist or may have moved.
        </p>

        <div class="not-found-actions">
          <a
            class="button primary home-button transition-transform duration-150 hover:scale-105"
            href="/"
          >
            <ArrowLeft size={18} aria-hidden="true" />
            Back to home
          </a>
          <a
            class="button secondary transition-transform duration-150 hover:scale-105"
            href="/#contact"
          >
            Contact
          </a>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .not-found-shell {
    display: grid;
    width: min(var(--content-max), calc(100% - 32px));
    min-height: calc(100vh - 96px);
    place-items: start center;
    margin-inline: auto;
    padding: 64px 0 80px;
  }

  .not-found-card {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(28px, 6vw, 48px);
  }

  .eyebrow {
    margin: 0 0 20px;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .not-found-copy {
    max-width: 470px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .home-button {
    gap: 9px;
  }

  .home-button:focus-visible,
  .not-found-actions .button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  @media (max-width: 660px) {
    .not-found-shell {
      width: min(100% - 24px, var(--content-max));
      min-height: auto;
      padding: 48px 0 64px;
    }

    .not-found-actions {
      flex-direction: column;
    }

    .not-found-actions .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found-actions .button {
      transition: none;
    }
  }
</style>
