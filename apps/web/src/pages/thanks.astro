---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="portfolio-page">
    <main>
      <section class="section flex flex-col items-start gap-6 py-16">
        <h1 class="mt-2 text-4xl leading-[1.05] tracking-[-0.06em]">
          Thank you for your message. I'll get back to you as soon as possible
        </h1>
        <a
          class="button primary transition-transform duration-150 hover:scale-105"
          href="/">Back to home</a
        >
      </section>
    </main>
  </div>
</Layout>
