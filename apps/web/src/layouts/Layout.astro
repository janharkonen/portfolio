---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { profile } from "../../../../packages/app_data/profile";

interface Props {
  bodyClass?: string;
  themeClass?: string;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  bodyClass = "min-h-screen bg-neutral-950 text-white max-w-screen-md mx-auto px-4",
  themeClass = "portfolio-makeover variant-3",
  title = "Jan Härkönen — Senior Full Stack Developer",
  description = "Jan Härkönen — Senior Full Stack Developer based in Helsinki, Finland",
  image = "/jan-1-8.webp",
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://janharkonen.fi");
const siteOrigin = siteURL.origin;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const personId = `${siteOrigin}/#person`;
const websiteId = `${siteOrigin}/#website`;
const homeLocation = profile.location.replace(/\s*🇫🇮\s*$/, "").trim();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: profile.name,
      jobTitle: profile.role,
      url: siteOrigin,
      image: imageURL.href,
      sameAs: [profile.github, profile.linkedin, profile.scholar],
      homeLocation: {
        "@type": "Place",
        name: homeLocation,
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteOrigin,
      name: profile.name,
      description,
      author: { "@id": personId },
      publisher: { "@id": personId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-inter" preload />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[bodyClass, themeClass]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
  </body>
</html>
