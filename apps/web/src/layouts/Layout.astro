---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { profile } from "../../../../packages/app_data/profile";

const DEFAULT_OG_IMAGE = "/jan-1-8.webp";
const DEFAULT_OG_IMAGE_META = {
  width: 500,
  height: 750,
  type: "image/webp",
  alt: "Portrait of Jan Härkönen, Senior Full Stack Developer",
} as const;

function mimeTypeFromImagePath(path: string): string | undefined {
  const pathname = path.split("?")[0]?.split("#")[0]?.toLowerCase() ?? "";
  if (pathname.endsWith(".webp")) return "image/webp";
  if (pathname.endsWith(".jpg") || pathname.endsWith(".jpeg")) return "image/jpeg";
  if (pathname.endsWith(".png")) return "image/png";
  if (pathname.endsWith(".gif")) return "image/gif";
  if (pathname.endsWith(".svg")) return "image/svg+xml";
  if (pathname.endsWith(".avif")) return "image/avif";
  return undefined;
}

interface Props {
  bodyClass?: string;
  themeClass?: string;
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  bodyClass = "min-h-screen bg-neutral-950 text-white max-w-screen-md mx-auto px-4",
  themeClass = "portfolio-makeover variant-3",
  title = "Jan Härkönen — Senior Full Stack Developer",
  description = "Jan Härkönen — Senior Full Stack Developer based in Helsinki, Finland",
  image = DEFAULT_OG_IMAGE,
  imageWidth,
  imageHeight,
  imageType,
  imageAlt = DEFAULT_OG_IMAGE_META.alt,
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://janharkonen.fi");
const siteOrigin = siteURL.origin;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const isDefaultOgImage = image === DEFAULT_OG_IMAGE;
const resolvedImageWidth =
  imageWidth ?? (isDefaultOgImage ? DEFAULT_OG_IMAGE_META.width : undefined);
const resolvedImageHeight =
  imageHeight ?? (isDefaultOgImage ? DEFAULT_OG_IMAGE_META.height : undefined);
const resolvedImageType =
  imageType ??
  (isDefaultOgImage
    ? DEFAULT_OG_IMAGE_META.type
    : mimeTypeFromImagePath(image));
const personId = `${siteOrigin}/#person`;
const websiteId = `${siteOrigin}/#website`;
const homeLocation = profile.location.replace(/\s*🇫🇮\s*$/, "").trim();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: profile.name,
      jobTitle: profile.role,
      url: siteOrigin,
      image: imageURL.href,
      telephone: profile.phone.replace(/\s+/g, ""),
      email: profile.email,
      sameAs: [profile.github, profile.linkedin, profile.scholar],
      homeLocation: {
        "@type": "Place",
        name: homeLocation,
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteOrigin,
      name: profile.name,
      description,
      author: { "@id": personId },
      publisher: { "@id": personId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f6f1e7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#16181d"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://picapi.janharkonen.fi" crossorigin />
    <link rel="dns-prefetch" href="https://picapi.janharkonen.fi" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" type="text/plain" />

    <Font cssVariable="--font-inter" preload />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    {
      resolvedImageWidth != null && (
        <meta property="og:image:width" content={String(resolvedImageWidth)} />
      )
    }
    {
      resolvedImageHeight != null && (
        <meta
          property="og:image:height"
          content={String(resolvedImageHeight)}
        />
      )
    }
    {
      resolvedImageType && (
        <meta property="og:image:type" content={resolvedImageType} />
      )
    }
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[bodyClass, themeClass]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
  </body>
</html>
