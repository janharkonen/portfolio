---
const links = [
  { to: "/pdf/resume", label: "CV" },
  { to: "https://www.linkedin.com/in/janharkonen", label: "LinkedIn", external: true },
  { to: "https://github.com/janharkonen", label: "Github", external: true },
  { to: "mailto:jan.harkonen@taitounited.fi", label: "Email" },
  { to: "https://scholar.google.com/citations?hl=en&user=a5q61ooAAAAJ", label: "Scholar", external: true },
];
---

<header class="sticky top-0 z-50 bg-neutral-950/80 backdrop-blur-md border-b border-neutral-800">
  <div class="container mx-auto max-w-5xl flex items-center justify-between px-4 py-3 md:px-6">
    <a href="/" class="text-lg font-semibold text-white hover:text-neutral-300 transition-colors">
      JH
    </a>
    <nav class="flex gap-4 text-sm">
      {links.map((link) => (
        <a
          href={link.to}
          class="text-neutral-400 hover:text-white transition-colors"
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
