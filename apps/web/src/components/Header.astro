---
const links = [
  { to: "/pdf/resume", label: "CV" },
  { to: "https://www.linkedin.com/in/janharkonen", label: "LinkedIn", external: true },
  { to: "https://github.com/janharkonen", label: "Github", external: true },
  { to: "mailto:jan.harkonen@pionblanc.fi", label: "Email" },
  { to: "https://scholar.google.com/citations?hl=en&user=a5q61ooAAAAJ", label: "Scholar", external: true },
];
---

<header class="site-nav">
    <a class="brand" href="/" aria-label={`Jan Härkönen home`}>
      <span>JH</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          href={link.to}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

  </header>
