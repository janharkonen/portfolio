---
import { Image } from "astro:assets";
import { brandedItems } from "../app_data/branded_items";
import { coreStack } from "../app_data/core_stack";
import { educations } from "../app_data/education";
import { experiences } from "../app_data/experience";
import { projects } from "../app_data/projects";

const profile = {
  name: "Jan Härkönen",
  role: "Senior Full Stack Developer",
  location: "Helsinki, Finland",
  line: "Writing software that's pleasant to look at",
  email: "jan.harkonen@taitounited.fi",
  phone: "+358 50 4646 745",
  github: "https://github.com/janharkonen",
  linkedin: "https://www.linkedin.com/in/janharkonen",
  scholar: "https://scholar.google.com/citations?hl=en&user=a5q61ooAAAAJ",
  cv: "/pdf/resume",
};

const activeStyle = {
  label: "Archive",
  eyebrow: "Index / Selected work",
  intro: "Product software, data systems, and practical tools.",
};

const navLinks = [
  { to: profile.cv, label: "CV" },
  { to: profile.linkedin, label: "LinkedIn", external: true },
  { to: profile.github, label: "Github", external: true },
  { to: `mailto:${profile.email}`, label: "Email" },
  { to: profile.scholar, label: "Scholar", external: true },
];
---

<div class="portfolio-makeover variant-3" data-portfolio-tabs>
  <header class="site-nav">
    <a class="brand" href="/" aria-label={`${profile.name} home`}>
      <span>JH</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a
          href={link.to}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{activeStyle.eyebrow}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="intro">{activeStyle.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={`mailto:${profile.email}`}>Start a conversation</a>
          <a class="button secondary" href={profile.cv}>View CV</a>
        </div>
      </div>

      <figure class="portrait-card">
        <div class="portrait-frame">
          <Image
            src="/jan-1-8.webp"
            alt={profile.name}
            width="500"
            height="750"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>{profile.location}</span>
          <strong>{profile.line}</strong>
        </figcaption>
      </figure>
    </section>

    <section class="section stack-section" aria-labelledby="core-stack-heading">
      <div class="section-heading">
        <p class="eyebrow">Core stack</p>
        <h2 id="core-stack-heading">Everyday tools</h2>
      </div>
      <div class="stack-grid">
        {coreStack.map((skill) => {
          const item = brandedItems[skill];

          return (
            <div class="stack-item">
              <Image
                src={item.logoUrl}
                alt={item.displayName}
                width={52}
                height={52}
                class="stack-logo"
              />
              <span>{item.displayName}</span>
            </div>
          );
        })}
      </div>
    </section>

    <section class="section timeline-section" aria-labelledby="timeline-heading">
      <div class="section-heading">
        <p class="eyebrow">Background</p>
        <h2 id="timeline-heading">Work and education</h2>
      </div>

      <div class="tabs">
        <div role="tablist" aria-label="Work history" class="tab-list">
          <button
            type="button"
            role="tab"
            id="tab-experience"
            aria-selected="true"
            aria-controls="panel-experience"
            data-tab="experience"
          >
            Work Experience
          </button>
          <button
            type="button"
            role="tab"
            id="tab-education"
            aria-selected="false"
            aria-controls="panel-education"
            data-tab="education"
            tabindex="-1"
          >
            Education
          </button>
        </div>

        <div
          role="tabpanel"
          id="panel-experience"
          aria-labelledby="tab-experience"
          class="timeline-list"
        >
          {experiences.map((job) => (
            <article class="timeline-card">
              <div class="card-heading">
                <h3>{job.role}</h3>
                <span>{job.period}</span>
              </div>
              <p class="organization">{job.company}</p>
              <p>{job.description}</p>
              <div class="tech-row">
                {job.tech.map((tech) => {
                  const item = brandedItems[tech];

                  return (
                    <Image
                      src={item.logoUrl}
                      alt={item.displayName}
                      title={item.displayName}
                      width={24}
                      height={24}
                      class="tech-logo"
                    />
                  );
                })}
              </div>
            </article>
          ))}
        </div>

        <div
          role="tabpanel"
          id="panel-education"
          aria-labelledby="tab-education"
          class="timeline-list"
          hidden
        >
          {educations.map((education) => (
            <article class="timeline-card">
              <div class="card-heading">
                <h3>{education.degree}</h3>
                <span>{education.period}</span>
              </div>
              <p class="organization">{education.school}</p>
              <p>{education.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section projects-section" aria-labelledby="projects-heading">
      <div class="section-heading">
        <p class="eyebrow">Projects</p>
        <h2 id="projects-heading">Selected builds</h2>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="card-heading">
              <h3>{project.name}</h3>
              <span>{project.year}</span>
            </div>
            <p>{project.description}</p>
            <div class="tech-row">
              {project.tech.map((tech) => {
                const item = brandedItems[tech];

                return (
                  <Image
                    src={item.logoUrl}
                    alt={item.displayName}
                    title={item.displayName}
                    width={24}
                    height={24}
                    class="tech-logo"
                  />
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="contact-footer">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Jan Härkönen</h2>
    </div>
    <div class="contact-links">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <span>{profile.phone}</span>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">Github</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </footer>
</div>

<script>
  function initPortfolioTabs(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    function selectTab(tab: HTMLButtonElement) {
      const name = tab.dataset.tab;
      if (!name) return;

      tabs.forEach((item) => {
        const isSelected = item === tab;
        item.setAttribute("aria-selected", String(isSelected));
        item.tabIndex = isSelected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== `panel-${name}`;
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => selectTab(tab));

      tab.addEventListener("keydown", (event) => {
        const index = tabs.indexOf(tab);
        let nextIndex: number | null = null;

        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;

        if (nextIndex !== null) {
          event.preventDefault();
          selectTab(tabs[nextIndex]);
          tabs[nextIndex].focus();
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-portfolio-tabs]").forEach(initPortfolioTabs);
</script>

<style>
  .portfolio-makeover {
    --page: #f7f3ea;
    --surface: rgba(255, 255, 255, 0.76);
    --surface-strong: #ffffff;
    --ink: #18212d;
    --muted: #667085;
    --line: rgba(24, 33, 45, 0.16);
    --accent: #1f5eff;
    --accent-2: #f7b267;
    --radius: 28px;
    --shadow: 0 26px 70px rgba(24, 33, 45, 0.12);
    --content-max: 960px;
    min-height: 100vh;
    overflow: hidden;
    background: var(--page);
    color: var(--ink);
    font-family: Inter, system-ui, sans-serif;
  }

  .portfolio-makeover a {
    color: inherit;
    text-decoration: none;
  }

  .site-nav,
  .hero,
  .section,
  .contact-footer {
    width: min(var(--content-max), calc(100% - 32px));
    margin-inline: auto;
  }

  .site-nav {
    position: sticky;
    top: 12px;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    margin-top: 12px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-strong) 84%, transparent);
    box-shadow: 0 14px 38px rgba(24, 33, 45, 0.08);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
  }

  .brand span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 999px;
    background: var(--ink);
    color: var(--page);
    letter-spacing: -0.08em;
  }

  .brand small,
  .eyebrow {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .primary-nav,
  .hero-actions,
  .tech-row,
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .primary-nav {
    justify-content: flex-end;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .primary-nav a {
    border-radius: 999px;
    padding: 8px 11px;
  }

  .primary-nav a:hover {
    background: color-mix(in srgb, var(--accent) 11%, transparent);
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 54px;
    align-items: center;
    padding: 92px 0 74px;
  }

  .hero-copy h1 {
    max-width: 820px;
    margin: 16px 0 12px;
    font-size: clamp(4.4rem, 10vw, 9.4rem);
    line-height: 0.82;
    letter-spacing: -0.09em;
  }

  .role {
    margin: 0;
    color: var(--accent);
    font-size: clamp(1.35rem, 2.6vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 620px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 18px;
    font-weight: 800;
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: white;
  }

  .button.secondary {
    background: var(--surface);
  }

  .portrait-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .portrait-frame {
    overflow: hidden;
    border-radius: calc(var(--radius) - 10px);
    background: color-mix(in srgb, var(--accent-2) 24%, white);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 18%;
  }

  .portrait-card figcaption {
    display: grid;
    gap: 5px;
    padding: 14px 4px 2px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .portrait-card strong {
    color: var(--ink);
    font-size: 1rem;
  }

  .section {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 42px;
    padding: 58px 0;
    border-top: 1px solid var(--line);
  }

  .section-heading h2,
  .contact-footer h2 {
    margin: 8px 0 0;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }

  .stack-item {
    display: grid;
    min-height: 118px;
    align-content: center;
    justify-items: center;
    gap: 14px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 800;
    text-align: center;
  }

  .stack-logo {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .tabs {
    display: grid;
    gap: 18px;
  }

  .tab-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px;
    background: var(--surface);
  }

  .tab-list button {
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    padding: 13px 18px;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 900;
  }

  .tab-list button[aria-selected="true"] {
    background: var(--ink);
    color: var(--page);
    box-shadow: 0 10px 24px rgba(24, 33, 45, 0.14);
  }

  .timeline-list {
    display: grid;
    gap: 14px;
  }

  .timeline-card,
  .project-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 16px 34px rgba(24, 33, 45, 0.07);
  }

  .timeline-card {
    padding: 22px;
  }

  .card-heading {
    display: flex;
    gap: 14px;
    align-items: baseline;
    justify-content: space-between;
  }

  .card-heading h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }

  .card-heading span {
    flex: none;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .organization {
    color: var(--accent);
    font-weight: 900;
  }

  .timeline-card p,
  .project-card p {
    margin: 9px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .tech-row {
    margin-top: 16px;
    gap: 8px;
  }

  .tech-logo {
    display: block;
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .project-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    padding: 22px;
  }

  .project-card .tech-row {
    margin-top: auto;
    padding-top: 20px;
  }

  .contact-footer {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 58px 0 72px;
    border-top: 1px solid var(--line);
  }

  .contact-links {
    max-width: 620px;
    justify-content: flex-end;
    color: var(--muted);
    font-weight: 800;
  }

  .contact-links a:hover {
    color: var(--accent);
  }

  .variant-1 {
    --page: #f5efe1;
    --surface: rgba(255, 251, 242, 0.86);
    --surface-strong: #fffaf0;
    --ink: #12243a;
    --muted: #6b6b62;
    --line: rgba(18, 36, 58, 0.2);
    --accent: #be5a38;
    --accent-2: #eecf9f;
    --radius: 12px;
    --shadow: 12px 12px 0 rgba(18, 36, 58, 0.1);
    background:
      linear-gradient(90deg, rgba(18, 36, 58, 0.055) 1px, transparent 1px) 0 0 / 84px 84px,
      var(--page);
    font-family: Georgia, "Times New Roman", serif;
  }

  .variant-1 .site-nav,
  .variant-1 .button,
  .variant-1 .tab-list button,
  .variant-1 .stack-item,
  .variant-1 .timeline-card,
  .variant-1 .project-card,
  .variant-1 .contact-links {
    font-family: Inter, system-ui, sans-serif;
  }

  .variant-1 .hero {
    grid-template-columns: minmax(0, 1fr) 330px;
  }

  .variant-1 .hero-copy h1 {
    text-transform: uppercase;
  }

  .variant-1 .project-card:nth-child(3n + 1) {
    background: #12243a;
    color: #fffaf0;
  }

  .variant-1 .project-card:nth-child(3n + 1) p,
  .variant-1 .project-card:nth-child(3n + 1) .card-heading span {
    color: rgba(255, 250, 240, 0.7);
  }

  .variant-2 {
    --page: #f4f0dd;
    --surface: rgba(255, 252, 238, 0.92);
    --surface-strong: #fff9e8;
    --ink: #142018;
    --muted: #60705f;
    --line: rgba(20, 32, 24, 0.22);
    --accent: #208a4b;
    --accent-2: #b8f2c8;
    --radius: 10px;
    --shadow: 10px 10px 0 rgba(20, 32, 24, 0.1);
    background:
      linear-gradient(rgba(32, 138, 75, 0.12) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgba(32, 138, 75, 0.12) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--page);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .variant-2 .site-nav,
  .variant-2 .button,
  .variant-2 .tab-list button,
  .variant-2 .stack-item,
  .variant-2 .timeline-card,
  .variant-2 .project-card,
  .variant-2 .contact-links {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .variant-2 .hero {
    grid-template-columns: minmax(0, 1fr) 260px;
  }

  .variant-2 .hero-copy h1 {
    font-family: Inter, system-ui, sans-serif;
    text-transform: uppercase;
  }

  .variant-2 .hero-copy h1::before {
    display: block;
    color: var(--accent);
    content: "> ";
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.24em;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .variant-2 .card-heading h3::before {
    color: var(--accent);
    content: "$ ";
  }

  .variant-2 .project-card:nth-child(3n + 1) {
    background: #142018;
    color: #f4f0dd;
  }

  .variant-2 .project-card:nth-child(3n + 1) p,
  .variant-2 .project-card:nth-child(3n + 1) .card-heading span {
    color: rgba(244, 240, 221, 0.72);
  }

  .variant-3 {
    --page: #f6f1e7;
    --surface: #fffaf0;
    --surface-strong: #fffaf0;
    --ink: #1d2430;
    --muted: #6d716f;
    --line: rgba(29, 36, 48, 0.24);
    --accent: #365f8c;
    --accent-2: #d8c7a0;
    --radius: 2px;
    --shadow: 0 18px 0 rgba(29, 36, 48, 0.05);
    background:
      linear-gradient(90deg, rgba(29, 36, 48, 0.06) 1px, transparent 1px) 0 0 / 56px 56px,
      var(--page);
    counter-reset: project;
    font-family: Inter, system-ui, sans-serif;
  }

  .variant-3 .site-nav,
  .variant-3 .portrait-card,
  .variant-3 .stack-item,
  .variant-3 .timeline-card,
  .variant-3 .project-card,
  .variant-3 .tab-list {
    border-radius: 2px;
  }

  .variant-3 .hero {
    grid-template-columns: minmax(0, 1fr) 260px;
  }

  .variant-3 .hero-copy h1 {
    max-width: 900px;
    font-size: clamp(4rem, 8.8vw, 8.3rem);
    text-transform: uppercase;
  }

  .variant-3 .portrait-card {
    transform: rotate(1.25deg);
  }

  .variant-3 .project-card {
    position: relative;
    padding-top: 54px;
  }

  .variant-3 .project-card::before {
    position: absolute;
    top: 18px;
    left: 22px;
    color: var(--accent);
    content: "No. " counter(project, decimal-leading-zero);
    counter-increment: project;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .variant-3 .project-card:nth-child(4n + 1) {
    background: #1d2430;
    color: #fffaf0;
  }

  .variant-3 .project-card:nth-child(4n + 1) p,
  .variant-3 .project-card:nth-child(4n + 1) .card-heading span {
    color: rgba(255, 250, 240, 0.72);
  }

  .variant-4 {
    --page: #eff7f2;
    --surface: rgba(255, 255, 248, 0.9);
    --surface-strong: #fffff8;
    --ink: #132f32;
    --muted: #60787a;
    --line: rgba(19, 47, 50, 0.2);
    --accent: #f05b36;
    --accent-2: #a8e6df;
    --radius: 18px;
    --shadow: 10px 10px 0 rgba(19, 47, 50, 0.09);
    background:
      repeating-linear-gradient(135deg, rgba(240, 91, 54, 0.08) 0 2px, transparent 2px 18px),
      radial-gradient(circle at 78% 14%, rgba(168, 230, 223, 0.9), transparent 26%),
      var(--page);
    font-family: Inter, system-ui, sans-serif;
  }

  .variant-4 .hero {
    grid-template-columns: minmax(0, 1fr) 260px;
  }

  .variant-4 .hero-copy h1 {
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
    text-transform: uppercase;
  }

  .variant-4 .portrait-card {
    border-radius: 999px 999px 32px 32px;
  }

  .variant-4 .portrait-frame {
    border-radius: 999px 999px 24px 24px;
