---
import { experiences } from "../app_data/experience";
import { educations } from "../app_data/education";
import Logo from "./Logo.astro";

const tabClass =
  "rounded-md py-3 px-6 text-sm font-medium transition-colors cursor-pointer text-neutral-500 hover:text-neutral-300 aria-selected:bg-neutral-800 aria-selected:text-white aria-selected:shadow-sm";
---

<section class="mb-20" data-tabs>
  <!-- Tabs -->
  <div
  role="tablist"
  aria-label="Work history"
  class="grid grid-cols-2 gap-1 rounded-lg bg-neutral-900 p-1 mb-8 h-14"
  >
  <button
  type="button"
  role="tab"
  id="tab-experience"
      aria-selected="true"
      aria-controls="panel-experience"
      data-tab="experience"
      class={tabClass}
    >
      Work Experience
    </button>
    <button
      type="button"
      role="tab"
      id="tab-education"
      aria-selected="false"
      aria-controls="panel-education"
      data-tab="education"
      tabindex="-1"
      class={tabClass}
    >
      Education
    </button>
  </div>

  <!-- Experience -->
  <div
    role="tabpanel"
    id="panel-experience"
    aria-labelledby="tab-experience"
    class="space-y-8"
  >
    {
      experiences.map((job) => (
        <div class="group">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-1">
            <h4 class="text-lg font-medium text-white">{job.role}</h4>
            <span class="text-sm text-neutral-500">{job.period}</span>
          </div>
          <p class="text-neutral-400 font-medium mb-2">{job.company}</p>
          <p class="text-neutral-500 text-sm mb-3">{job.description}</p>
          <div class="flex flex-wrap gap-2">
            {job.tech.map((t) => (
              <Logo skill={t} />
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Education -->
  <div
    role="tabpanel"
    id="panel-education"
    aria-labelledby="tab-education"
    class="space-y-8"
    hidden
  >
    {
      educations.map((education) => (
        <div class="group">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-1">
            <h4 class="text-lg font-medium text-white">{education.degree}</h4>
            <span class="text-sm text-neutral-500">{education.period}</span>
          </div>
          <p class="text-neutral-400 font-medium mb-2">{education.school}</p>
          <p class="text-neutral-500 text-sm mb-3">{education.description}</p>
          <div class="flex flex-wrap gap-2">
            {education.documents.map((d) => (
              <span class="text-xs px-2 py-1 rounded bg-neutral-900 text-neutral-500">{d}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  function initTabs(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    function selectTab(tab: HTMLButtonElement) {
      const name = tab.dataset.tab;
      if (!name) return;

      tabs.forEach((t) => {
        const isSelected = t === tab;
        t.setAttribute("aria-selected", String(isSelected));
        t.tabIndex = isSelected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== `panel-${name}`;
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => selectTab(tab));

      tab.addEventListener("keydown", (event) => {
        const index = tabs.indexOf(tab);
        let nextIndex: number | null = null;

        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;

        if (nextIndex !== null) {
          event.preventDefault();
          selectTab(tabs[nextIndex]);
          tabs[nextIndex].focus();
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(initTabs);
</script>
