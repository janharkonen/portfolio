---
import type { BrandedItemKey } from "../../../../packages/app_data/branded_items";
import { brandedItems } from "../../../../packages/app_data/branded_items";

interface Props {
  skill: BrandedItemKey;
}

const { skill } = Astro.props;
const brandedItem = brandedItems[skill];
---

<span class="tech-logo" title={brandedItem.displayName}>
  <img
    src={brandedItem.logoUrl}
    alt=""
    width="16"
    height="16"
    class="tech-logo__icon"
    loading="lazy"
    decoding="async"
  />
  <span class="tech-logo__name">{brandedItem.displayName}</span>
</span>
