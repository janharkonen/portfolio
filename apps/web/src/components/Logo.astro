---
import type { BrandedItemKey } from "../../../../packages/app_data/branded_items";
import { brandedItems } from "../../../../packages/app_data/branded_items";
import { Image } from "astro:assets";

interface Props {
  skill: BrandedItemKey;
}

const { skill } = Astro.props;
const brandedItem = brandedItems[skill];
---

<div class="flex h-6 w-6 shrink-0 items-center justify-center">
  <Image
    src={brandedItem.logoUrl}
    alt={brandedItem.displayName}
    width={24}
    height={24}
    class="max-h-6 max-w-6 object-contain"
    loading="lazy"
  />
</div>
