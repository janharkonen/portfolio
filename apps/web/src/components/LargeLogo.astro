---
import type { BrandedItemKey } from "../app_data/branded_items";
import { brandedItems } from "../app_data/branded_items";
import { Image } from "astro:assets";

interface Props {
  skill: BrandedItemKey;
}

const { skill } = Astro.props;
const brandedItem = brandedItems[skill];
---

<div class="flex flex-col items-center gap-1.5">
  <div class="flex h-12 w-12 shrink-0 items-center justify-center">
    <Image
      src={brandedItem.logoUrl}
      alt={brandedItem.displayName}
      width={48}
      height={48}
      class="max-h-12 max-w-12 object-contain"
    />
  </div>
  <span class="text-center text-xs leading-tight font-medium text-neutral-400">
    {brandedItem.displayName}
  </span>
</div>
